import BaseLayout from '../../layouts/BaseLayout.astro';
const title = 'Peaking Blocks for Strength | 1rmaxcalculator.com';
const description = 'How to structure a 4–8 week peaking block to hit a new 1RM. Intensity progressions, volume tapering, deloads, and what to do on meet day.';
---
<BaseLayout title={title} description={description}>
  <h1>Peaking Blocks for Strength</h1>
  <p>A peaking block is a 4&ndash;8 week training phase designed to maximize 1RM strength on a target date &mdash; meet day, a testing day, or just a personal milestone.</p>

  <h2>Sample 6-week peak</h2>
  <ul>
    <li><strong>Week 1:</strong> 75% &times; 5 reps, 4 sets</li>
    <li><strong>Week 2:</strong> 80% &times; 4 reps, 4 sets</li>
    <li><strong>Week 3:</strong> 85% &times; 3 reps, 3 sets</li>
    <li><strong>Week 4:</strong> 90% &times; 2 reps, 3 sets</li>
    <li><strong>Week 5:</strong> 95% &times; 1 rep, 2&ndash;3 sets</li>
    <li><strong>Week 6:</strong> Deload &mdash; 60% &times; 3 reps, 3 sets, then test/meet</li>
  </ul>

  <h2>Key principles</h2>
  <ul>
    <li><strong>Intensity goes up; volume goes down.</strong> As you approach test day, fewer sets and reps at higher percentages.</li>
    <li><strong>Deload the final week.</strong> Don't try to peak on top of accumulated fatigue. The taper week is when you actually realize the strength you've built.</li>
    <li><strong>One main lift per session.</strong> Accessory work decreases as you approach the peak.</li>
    <li><strong>Sleep and recover.</strong> The work is already done by week 5; the rest of the peak is about expression, not adaptation.</li>
  </ul>

  <h2>Common mistakes</h2>
  <ul>
    <li>Adding extra heavy attempts mid-peak "to test where you are." This is just adding fatigue.</li>
    <li>Skipping the deload because you feel strong. Trust the program.</li>
    <li>Trying to PR everything (squat, bench, deadlift) in the same peaking block. Pick one priority lift; maintain the others.</li>
  </ul>

  <h2>Meet day specifics</h2>
  <p>If you're competing, follow your federation's rules for attempt selection. A common opener strategy: opener at 92&ndash;94% of training max, second attempt at training max, third attempt 2&ndash;5% above. Adjust based on opener bar speed.</p>
</BaseLayout>
