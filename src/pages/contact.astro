---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Contact | 1rmaxcalculator.com';
const description = 'Get in touch with the team at 1rmaxcalculator.com for questions, corrections, or feedback.';
---
<BaseLayout title={title} description={description}>
  <h1>Contact</h1>
  <p>Questions, corrections, or suggestions about a calculator or guide? We'd like to hear from you.</p>

  <h2>Email</h2>
  <p>The fastest way to reach the editorial team is by email at <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>. We typically respond within a few business days.</p>

  <h2>What we respond to</h2>
  <ul>
    <li>Corrections to our calculator math or formulas</li>
    <li>Errors or unclear language in our guides</li>
    <li>Suggestions for new calculators or guide topics</li>
    <li>Press and partnership inquiries</li>
  </ul>

  <h2>What we don't respond to</h2>
  <p>We can't provide individual coaching, medical advice, or training prescriptions. If you have specific questions about your training or health, please work with a qualified coach or medical professional.</p>
</BaseLayout>
