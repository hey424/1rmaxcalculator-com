---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Editorial Team | 1rmaxcalculator.com';
const description = 'Meet the editorial team behind 1rmaxcalculator.com. Strength training writers and reviewers who maintain our calculators and guides.';
---
<BaseLayout title={title} description={description}>
  <h1>Editorial Team</h1>
  <p>1rmaxcalculator.com is written and reviewed by a small editorial team at The Click Lab. Every calculator's math is verified against published research, and every guide is reviewed by at least one team member before publication.</p>

  <h2>Editorial standards</h2>
  <ul>
    <li><strong>Accuracy first.</strong> We cite our sources for every formula and claim. Corrections are made promptly and dated.</li>
    <li><strong>No medical or training prescriptions.</strong> Our content is informational; specific decisions should involve a qualified coach or medical professional.</li>
    <li><strong>No paid placements.</strong> We don't accept money to recommend products, programs, or services.</li>
  </ul>

  <h2>Corrections</h2>
  <p>If you find an error in a calculator or guide, please email <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>. Verified corrections are made within a few business days and noted at the bottom of the affected page.</p>
</BaseLayout>
