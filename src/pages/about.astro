---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About 1rmaxcalculator.com | One Rep Max Calculator';
const description = 'About the team behind 1rmaxcalculator.com. We build free, accurate strength training calculators reviewed by the editorial team at The Click Lab.';
---
<BaseLayout title={title} description={description}>
  <h1>About 1rmaxcalculator.com</h1>
  <p>1rmaxcalculator.com is a free strength-training resource maintained by The Click Lab. Our calculators help lifters estimate 1RMs, score against bodyweight, plan macros, and program training around percentages.</p>

  <h2>What we do</h2>
  <p>We build practical tools and clear explanations for everyday lifters. Our calculators use published formulas from strength research, and every page is reviewed by our <a href="/editorial">editorial team</a> before publication.</p>

  <h2>What we don't do</h2>
  <p>We don't give medical advice, prescribe individualized training, or replace coaching. If you have an injury or a specific performance goal, work with a qualified coach or medical professional.</p>

  <h2>How we make money</h2>
  <p>This site is supported by display advertising via Google AdSense. We don't sell our reader data, and we don't accept payment for editorial coverage. See our <a href="/privacy">privacy policy</a> for details on what data is collected.</p>

  <h2>Contact</h2>
  <p>Questions, corrections, or suggestions are welcome &mdash; reach the team via our <a href="/contact">contact page</a>.</p>
</BaseLayout>
